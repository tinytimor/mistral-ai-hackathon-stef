# ─── Provider Selection ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Three providers available:
#   foundry → Microsoft Foundry (Mistral-Large-3 ONLY — sold directly by Azure)
#   mistral → Mistral La Plateforme API (all models, no marketplace needed)
#   local   → Open-source on RTX 5090 (32GB) via vLLM/Ollama
#
# ⚠️ Foundry partner models (Ministral-3B, Mistral-small-2503, etc.) need
#    Azure Marketplace subscription. Use "mistral" or "local" instead.
PROVIDER=foundry

# ─── Microsoft Foundry (Mistral-Large-3 deployed) ────────────────────────────
# Deploy at: ai.azure.com → Discover → Models → Mistral-Large-3 → Deploy
# Only Mistral-Large-3 is "sold directly by Azure" (no marketplace needed)
AZURE_RESOURCE_NAME=your-foundry-project-name
FOUNDRY_MODEL_NAME=Mistral-Large-3
# FOUNDRY_ENDPOINT=https://your-project.openai.azure.com/openai/v1/
# FOUNDRY_API_KEY=your-api-key  (or use `az login` for Entra ID auth)

# ─── Mistral La Plateforme (api.mistral.ai) ──────────────────────────────────
# All models: Large-3, Small, Ministral-8B/3B, Nemo, Codestral, Voxtral
# Sign up at https://console.mistral.ai/ — free tier includes API credits!
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL_NAME=mistral-large-latest

# ─── Local inference (RTX 5090, 32GB VRAM) ───────────────────────────────────
# Open-source models for QLoRA/LoRA training + inference
# Start server: vllm serve mistralai/Ministral-8B-Instruct-2410
# Or: ollama run ministral:8b
# LOCAL_BASE_URL=http://localhost:8000/v1/

# ─── OpenClaw Gateway (if running OpenClaw alongside) ────────────────────────
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_AUTH_TOKEN=your-openclaw-token

# ─── Communication Integrations ──────────────────────────────────────────────
# Gmail/Calendar/Drive (via gog CLI — OAuth-based, set up with `gog auth`)
# GOG_ACCOUNT=you@gmail.com

# WhatsApp (via wacli or OpenClaw WhatsApp channel)
# WHATSAPP_LINKED=true

# Signal (via signal-cli)
# SIGNAL_ACCOUNT=+15551234567

# Telegram (via grammY bot)
# TELEGRAM_BOT_TOKEN=your-bot-token

# iMessage (macOS only, via imsg CLI)
# IMESSAGE_ENABLED=true

# ─── Web Search ──────────────────────────────────────────────────────────────
# Brave Search API key (for web_search tool)
# BRAVE_API_KEY=your-brave-api-key

# ─── Smart Home ──────────────────────────────────────────────────────────────
# Philips Hue Bridge
# HUE_BRIDGE_IP=192.168.1.100
# HUE_API_KEY=your-hue-api-key

# Home Assistant
# HOMEASSISTANT_URL=http://homeassistant.local:8123
# HOMEASSISTANT_TOKEN=your-long-lived-access-token

# ─── Music ───────────────────────────────────────────────────────────────────
# Spotify (via spotify-player skill)
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── Social ──────────────────────────────────────────────────────────────────
# Twitter/X (via xurl CLI)
# XURL_CONFIGURED=true

# ─── TTS / Voice ─────────────────────────────────────────────────────────────
# ElevenLabs (for high-quality robot speech)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id

# ─── Hardware ────────────────────────────────────────────────────────────────
# Reachy Mini robot IP (find via LCD screen or dashboard)
REACHY_IP=192.168.1.42

# Jetson Orin Nano IP
ORIN_IP=192.168.1.50

# ─── Training ────────────────────────────────────────────────────────────────
# HuggingFace token (for gated models like Ministral)
# HF_TOKEN=hf_your_token_here

# Base model to fine-tune (on HuggingFace)
BASE_MODEL=mistralai/Ministral-8B-Instruct-2410
